    {
      "argv": [
        "macparakeet-cli",
        "history",
        "transcriptions",
        "--help"
      ],
      "exit_code": 0,
      "stderr_present": false,
      "stdout": "OVERVIEW: List recent transcriptions.\n\nUSAGE: macparakeet-cli history transcriptions [--limit <limit>] [--json] [--database <database>]\n\nOPTIONS:\n  -l, --limit <limit>     Maximum number of results. (default: 20)\n  --json                  Emit JSON instead of human-readable output.\n  --database <database>   Path to SQLite database file (defaults to the app\n                          database).\n  --version               Show the version.\n  -h, --help              Show help information."
    },
    {
      "argv": [
        "macparakeet-cli",
        "meetings",
        "corrections",
        "edit-line",
        "--help"
      ],
      "exit_code": 0,
      "stderr_present": false,
      "stdout": "OVERVIEW: Replace one timed line while retaining its segment envelope.\n\nUSAGE: macparakeet-cli meetings corrections edit-line <meeting> --segment <segment> [--text <text>] [--stdin] --expected-revision <expected-revision> [--json] [--envelope] [--database <database>]\n\nARGUMENTS:\n  <meeting>               Meeting UUID, UUID prefix, or exact title.\n\nOPTIONS:\n  --segment <segment>     Segment UUID from meetings transcript --format json.\n  --text <text>           Replacement text.\n  --stdin                 Read replacement text from stdin.\n  --expected-revision <expected-revision>\n                          Expected speakerCorrectionRevision from the last read.\n  --json                  Emit the updated transcript object as JSON.\n  --envelope              Wrap JSON output in an ok/data/meta envelope.\n  --database <database>   Path to SQLite database file (defaults to the app\n                          database).\n  --version               Show the version.\n  -h, --help              Show help information."
    },
    {
      "argv": [
        "macparakeet-cli",
        "meetings",
        "corrections",
        "rename",
        "--help"
      ],
      "exit_code": 0,
      "stderr_present": false,
      "stdout": "OVERVIEW: Rename one speaker in the reversible correction journal.\n\nUSAGE: macparakeet-cli meetings corrections rename <meeting> --speaker <speaker> --label <label> --expected-revision <expected-revision> [--json] [--envelope] [--database <database>]\n\nARGUMENTS:\n  <meeting>               Meeting UUID, UUID prefix, or exact title.\n\nOPTIONS:\n  --speaker <speaker>     Speaker id from meetings transcript --format json.\n  --label <label>         New display label.\n  --expected-revision <expected-revision>\n                          Expected speakerCorrectionRevision from the last read.\n  --json                  Emit the updated transcript object as JSON.\n  --envelope              Wrap JSON output in an ok/data/meta envelope.\n  --database <database>   Path to SQLite database file (defaults to the app\n                          database).\n  --version               Show the version.\n  -h, --help              Show help information."
    },
    {
      "argv": [
        "macparakeet-cli",
        "export",
        "--help"
      ],
      "exit_code": 0,
      "stderr_present": false,
      "stdout": "OVERVIEW: Export a transcription to a file.\n\nSupported formats: txt, markdown, srt, vtt, dapt, json.\n\nUSAGE: macparakeet-cli export <id> [--format <format>] [--output <output>] [--stdout] [--database <database>]\n\nARGUMENTS:\n  <id>                    The UUID (or prefix) of the transcription to export.\n\nOPTIONS:\n  -f, --format <format>   Output format: txt, markdown, srt, vtt, dapt, json.\n                          (values: txt, markdown, srt, vtt, dapt, json;\n                          default: txt)\n  -o, --output <output>   Output file path (defaults to current directory with\n                          auto-generated name).\n  --stdout                Print to stdout instead of writing a file.\n  --database <database>   Path to SQLite database file (defaults to the app\n                          database).\n  --version               Show the version.\n  -h, --help              Show help information."
    },
